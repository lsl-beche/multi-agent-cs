# ===== LLM配置 =====
# local = 本地GGUF模型（llama.cpp，免API Key，需先运行 scripts/start_local_llm.py）
# deepseek/qwen等 = 云端API（需填写LLM_API_KEY）
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== 本地LLM（LLM_PROVIDER=local 时生效）=====
LOCAL_LLM_MODEL_PATH=./models/qwen2.5-3b-instruct-q4_k_m.gguf
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8001
LOCAL_LLM_CTX=4096

# ===== Embedding模型 =====
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== 向量数据库 =====
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/vectordb
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== PostgreSQL =====
POSTGRES_URL=postgresql+psycopg://postgres:your-password@localhost:5432/csagent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 电商业务API Gateway =====
BIZ_API_GATEWAY_URL=http://localhost:9000
BIZ_API_TOKEN=your-biz-api-token

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development

# ===== 安全密钥（生产环境必须配置，缺失会拒绝启动）=====
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=
# JWT 签名密钥（至少32字符）
JWT_SECRET_KEY=
# PII字段加密密钥（32字节，base64编码）
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ===== CORS（JSON数组）=====
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# ===== 限流（每分钟请求数）=====
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_ORDER=10
