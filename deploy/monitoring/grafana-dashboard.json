{
  "title": "CSagent 客服平台监控",
  "uid": "csagent-overview",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "QPS / 错误率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(csagent_http_requests_total[1m]))", "legendFormat": "QPS"},
        {"expr": "sum(rate(csagent_http_requests_total{status=~\"5..|429\"}[1m])) / sum(rate(csagent_http_requests_total[1m]))", "legendFormat": "错误率"}
      ]
    },
    {
      "id": 2,
      "title": "HTTP P99 延迟",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(csagent_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99"}
      ]
    },
    {
      "id": 3,
      "title": "LLM 调用耗时（按任务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(csagent_llm_duration_seconds_bucket[5m])) by (le, task))", "legendFormat": "{{task}} P95"}
      ]
    },
    {
      "id": 4,
      "title": "业务事件计数",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(increase(csagent_orders_created_total[1h]))", "legendFormat": "订单/时"},
        {"expr": "sum(increase(csagent_payments_paid_total[1h]))", "legendFormat": "支付/时"},
        {"expr": "sum(increase(csagent_refunds_completed_total[1h]))", "legendFormat": "退款到账/时"},
        {"expr": "sum(increase(csagent_handoffs_total[1h]))", "legendFormat": "转人工/时"}
      ]
    },
    {
      "id": 5,
      "title": "在线会话",
      "type": "stat",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {"expr": "csagent_active_chats", "legendFormat": "进行中会话"},
        {"expr": "csagent_ws_users_online", "legendFormat": "在线用户"},
        {"expr": "csagent_ws_admins_online", "legendFormat": "在线管理员"}
      ]
    }
  ],
  "schemaVersion": 39
}
